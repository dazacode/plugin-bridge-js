{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"baseUrl": ".",
		"paths": {
			"@plugin-bridge/core/*": ["packages/core/src/*"],
			"@plugin-bridge/runtime/*": ["packages/runtime/src/*"],
			"@plugin-bridge/adapters/*": ["packages/adapters/src/*"],
			"@plugin-bridge/host/*": ["packages/host/src/*"],
			"@plugin-bridge/host-node/*": ["packages/host-node/src/*"]
		}
	},
	"include": ["packages/**/*.ts", "fixtures/**/*.json"]
}

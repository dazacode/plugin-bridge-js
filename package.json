{
	"name": "plugin-bridge-js",
	"version": "0.1.0",
	"private": false,
	"description": "A compatibility and translation toolkit for adapting foreign plugin ecosystems into a portable JavaScript runtime.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"bin": {
		"plugin-bridge": "packages/cli/src/main.ts"
	},
	"scripts": {
		"test": "vitest run",
		"check": "tsc --noEmit",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"generate": "bun packages/cli/src/main.ts generate",
		"boundary": "bun packages/cli/src/main.ts boundary",
		"bridge": "bun packages/cli/src/main.ts"
	},
	"devDependencies": {
		"@types/node": "^24",
		"prettier": "^3.8.3",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.11",
		"web-tree-sitter": "0.20.8"
	}
}
